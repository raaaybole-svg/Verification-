
<!DOCTYPE html>
<html lang="mr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>महिला लोन ऑनलाइन व्हेरिफिकेशन 2026</title>

<style>
:root {
  --navy:#12345a;
  --blue:#1769aa;
  --light:#f1f5f9;
  --border:#d8e0e9;
  --green:#16834a;
  --red:#bd3030;
}
* { box-sizing:border-box; }
body {
  margin:0;
  background:var(--light);
  color:#202b38;
  font-family:Arial,"Noto Sans Devanagari",sans-serif;
  line-height:1.55;
}
header {
  background:linear-gradient(135deg,#102d50,#1769aa);
  color:white;
  padding:24px 16px;
  text-align:center;
  border-bottom:4px solid #d4ad55;
}
header h1 { margin:0 0 6px; font-size:23px; }
header p { margin:0; font-size:13px; }
.container { max-width:760px; margin:18px auto; padding:0 12px 35px; }
.card {
  background:#fff;
  border:1px solid var(--border);
  border-radius:12px;
  padding:18px;
  margin-bottom:15px;
  box-shadow:0 3px 12px #142b4410;
}
h2 {
  color:var(--navy);
  font-size:18px;
  margin:0 0 14px;
  padding-bottom:9px;
  border-bottom:1px solid var(--border);
}
label { display:block; font-weight:600; margin:12px 0 5px; font-size:14px; }
input, textarea, select {
  display:block;
  width:100%;
  padding:12px;
  font-size:16px;
  border:1px solid #bcc9d7;
  border-radius:8px;
  background:white;
  color:#172333;
}
input:focus, textarea:focus {
  outline:2px solid #a7d0fa;
  border-color:var(--blue);
}
button {
  border:0;
  border-radius:8px;
  padding:12px 15px;
  background:var(--blue);
  color:white;
  font-size:15px;
  font-weight:700;
  cursor:pointer;
  margin-top:12px;
}
button:disabled { opacity:.55; cursor:wait; }
button.secondary { background:#e8eef5; color:var(--navy); }
button.success { background:var(--green); }
button.danger { background:#8e3030; }
.full { width:100%; }
.hidden { display:none !important; }
.note { font-size:13px; color:#526174; }
.status {
  padding:12px;
  border-radius:8px;
  background:#eaf2fb;
  margin:12px 0;
  overflow-wrap:anywhere;
}
.status.error { background:#ffeded; color:#9b2020; }
.status.ok { background:#e8f7ed; color:#126436; }
.detail {
  display:grid;
  grid-template-columns:1fr;
  gap:8px;
}
.detail div { padding:9px; background:#f5f8fb; border-radius:6px; }
.detail strong { display:block; color:#43566b; font-size:12px; }
#agreementContent {
  white-space:pre-wrap;
  overflow-wrap:anywhere;
  max-height:300px;
  overflow:auto;
  padding:14px;
  border:1px solid var(--border);
  border-radius:8px;
  background:#fafbfd;
}
.checkrow { display:flex; align-items:flex-start; gap:9px; margin-top:14px; }
.checkrow input { width:20px; height:20px; flex-shrink:0; margin-top:2px; }
.checkrow label { margin:0; font-weight:500; }
#signatureCanvas {
  display:block;
  width:100%;
  height:180px;
  border:2px dashed #9aabba;
  border-radius:8px;
  background:#fff;
  touch-action:none;
}
.preview {
  max-width:100%;
  max-height:260px;
  display:block;
  margin-top:10px;
  border-radius:8px;
  border:1px solid var(--border);
}
footer { text-align:center; color:#667487; font-size:12px; padding:14px; }
@media(min-width:560px) {
  .detail { grid-template-columns:1fr 1fr; }
  header h1 { font-size:28px; }
}
</style>
</head>

<body>
<header>
  <h1>महिला ग्रुप लोन 2026</h1>
  <p>ऑनलाइन अर्ज पडताळणी व संमती प्रक्रिया</p>
</header>

<main class="container">
  <div id="message" class="status" role="status" aria-live="polite">
    कृपया मोबाईल नंबर आणि Application ID भरा.
  </div>

  <section class="card step-card" id="searchCard">
    <h2>1. अर्ज शोधा</h2>
    <label for="mobile">नोंदणीकृत मोबाईल नंबर</label>
    <input id="mobile" type="tel" inputmode="numeric" maxlength="10"
           placeholder="10 अंकी मोबाईल नंबर" autocomplete="tel">

    <label for="applicationId">Application ID</label>
    <input id="applicationId" type="text" placeholder="तुमचा अर्ज क्रमांक">

    <button class="full" id="searchBtn" onclick="searchApplication()">
      अर्ज तपासा
    </button>
    <p class="note">
      तुमच्या जुन्या अर्जात नोंदवलेला मोबाईल नंबर आणि Application ID वापरा.
    </p>
  </section>

  <section class="card step-card hidden" id="memberCard">
    <h2>2. अर्जदाराची माहिती</h2>
    <div id="memberDetails" class="detail"></div>
    <div class="status">
      <strong>Verification Number:</strong>
      <div id="verificationNumber">तयार होत आहे...</div>
    </div>
    <p class="note">दाखवलेली माहिती तपासा. चुकीची माहिती असल्यास पुढे जाण्याआधी कार्यालयाशी संपर्क साधा.</p>
    <button class="full" onclick="goToSelfie()">पुढे जा →</button>
  </section>

  <section class="card step-card hidden" id="selfieCard">
    <h2>3. सेल्फी फोटो</h2>
    <label for="selfie">मोबाईल कॅमेऱ्यातून फोटो घ्या</label>
    <input id="selfie" type="file" accept="image/*" capture="user">
    <img id="selfiePreview" class="preview hidden" alt="सेल्फी पूर्वदृश्य">
    <button class="full" id="selfieBtn" onclick="uploadSelfie()">सेल्फी सेव्ह करा</button>
    <p class="note">स्पष्ट फोटो निवडा. फोटो अपलोड झाल्याची पुष्टी मिळेपर्यंत पुढे जाऊ नका.</p>
  </section>

  <section class="card step-card hidden" id="agreementCard">
    <h2>4. करारपत्र व संमती</h2>
    <p id="agreementTitle"><strong>करारपत्र</strong></p>
    <div id="agreementContent">करारपत्र लोड होत आहे...</div>
    <div class="checkrow">
      <input type="checkbox" id="agree">
      <label for="agree">मी संपूर्ण करारपत्र वाचले आहे. त्यातील अटी समजून घेतल्या आहेत आणि मी स्वेच्छेने संमती देत आहे.</label>
    </div>
    <button class="full" id="agreeBtn" onclick="acceptAgreement()">संमती नोंदवा</button>
  </section>

  <section class="card step-card hidden" id="bankCard">
    <h2>5. बँक तपशील</h2>
    <label for="holder">खातेदाराचे पूर्ण नाव</label>
    <input id="holder" autocomplete="name" placeholder="बँक खात्याप्रमाणे नाव">

    <label for="bank">बँकेचे नाव</label>
    <input id="bank" placeholder="बँकेचे नाव">

    <label for="account">बँक खाते क्रमांक</label>
    <input id="account" inputmode="numeric" autocomplete="off"
           placeholder="खाते क्रमांक">

    <label for="ifsc">IFSC कोड</label>
    <input id="ifsc" maxlength="11" autocapitalize="characters"
           placeholder="उदा. ABCD0123456">

    <label for="branch">शाखेचे नाव</label>
    <input id="branch" placeholder="बँक शाखा">

    <button class="full" id="bankBtn" onclick="saveBank()">बँक तपशील सेव्ह करा</button>
    <p class="note">खाते क्रमांक व IFSC काळजीपूर्वक तपासा. ही माहिती फक्त अधिकृत पडताळणी प्रक्रियेत वापरा.</p>
  </section>

  <section class="card step-card hidden" id="signatureCard">
    <h2>6. डिजिटल सही</h2>
    <p class="note">खालील जागेत बोटाने सही करा.</p>
    <canvas id="signatureCanvas" aria-label="सही करण्याची जागा"></canvas>
    <button class="secondary" onclick="clearSignature()">सही पुसा</button>
    <button class="full" id="signatureBtn" onclick="saveSignature()">सही सेव्ह करा</button>
  </section>

  <section class="card step-card hidden" id="finishCard">
    <h2>7. पडताळणी क्रमांक</h2>
    <div class="status ok">
      <strong>तुमचा Verification Number</strong>
      <div id="finalNumber" style="font-size:22px;font-weight:bold;margin-top:8px"></div>
    </div>
    <p>हा क्रमांक कार्यालयातील अधिकृत प्रतिनिधीला द्या. अंतिम मंजुरी कार्यालयाकडून तपासल्यानंतरच होईल.</p>
    <button class="full" onclick="copyNumber()">क्रमांक कॉपी करा</button>
  </section>

  <footer>महिला ग्रुप 2026 · ऑनलाइन पडताळणी</footer>
</main>

<script>
'use strict';

/*
 * तुमची Apps Script Web App URL.
 * हा URL deploy केलेल्या योग्य आवृत्तीचा असावा.
 */
const API_URL =
'https://script.google.com/macros/s/AKfycbxLVFgbVzZik_DuB5Pyspj6qotUTvdfxeNCaWcTae9gO2oS3DhgBb0vfVpPVbd-uBuA/exec';

let verificationId = '';
let verificationNumber = '';
let agreementVersion = '';
let selfieSaved = false;
let agreementSaved = false;
let bankSaved = false;
let signatureSaved = false;

const $ = id => document.getElementById(id);

function showMessage(message, type='') {
  const el = $('message');
  el.textContent = message;
  el.className = 'status' + (type ? ' ' + type : '');
}

function setBusy(buttonId, busy, label) {
  const b = $(buttonId);
  b.disabled = busy;
  if (busy) {
    b.dataset.oldLabel = b.textContent;
    b.textContent = label || 'कृपया थांबा...';
  } else {
    b.textContent = b.dataset.oldLabel || b.textContent;
  }
}

function showSection(id) {
  document.querySelectorAll('.step-card').forEach(card => {
    card.classList.add('hidden');
  });
  $(id).classList.remove('hidden');
  window.scrollTo({top: 0, behavior: 'smooth'});
  if (id === 'signatureCard') {
    // Canvas hidden असताना त्याची रुंदी शून्य होऊ नये.
    resizeCanvas();
  }
}

function goToSelfie() {
  if (!verificationId) {
    showMessage('प्रथम अर्ज तपासा.', 'error');
    return;
  }
  showSection('selfieCard');
  showMessage('आता सेल्फी फोटो घ्या आणि सेव्ह करा.', 'ok');
}

/*
 * GET साठी JSONP वापरले आहे.
 * Apps Script doGet मध्ये callback support आवश्यक आहे.
 */
function getJSONP(params) {
  return new Promise((resolve, reject) => {
    const callback = 'jsonp_' + Date.now() + '_' +
      Math.random().toString(36).slice(2);
    const script = document.createElement('script');
    const query = new URLSearchParams({...params, callback}).toString();
    let done = false;

    const timer = setTimeout(() => finish(
      new Error('सर्व्हरकडून उत्तर मिळाले नाही. पुन्हा प्रयत्न करा.')
    ), 20000);

    function finish(err, result) {
      if (done) return;
      done = true;
      clearTimeout(timer);
      delete window[callback];
      script.remove();
      err ? reject(err) : resolve(result);
    }

    window[callback] = result => finish(null, result);
    script.onerror = () => finish(
      new Error('API जोडणी झाली नाही. Web App deployment तपासा.')
    );
    script.src = API_URL + '?' + query;
    document.body.appendChild(script);
  });
}

/*
 * POST साठी text/plain वापरले आहे जेणेकरून preflight टाळता येईल.
 * Google Apps Script कडील CORS/redirect धोरणानुसार हा कॉल
 * काही hosting परिस्थितीत अयशस्वी होऊ शकतो.
 */
async function postAPI(data) {
  const response = await fetch(API_URL, {
    method: 'POST',
    headers: {'Content-Type': 'text/plain;charset=UTF-8'},
    body: JSON.stringify(data),
    redirect: 'follow'
  });
  if (!response.ok) throw new Error('सर्व्हरने विनंती स्वीकारली नाही.');
  return await response.json();
}

function safeText(value) {
  return String(value == null ? '' : value);
}

const displayFields = [
  ['Full_Name', 'पूर्ण नाव'],
  ['Application_ID', 'Application ID'],
  ['Group_ID', 'Group ID'],
  ['Member_ID', 'Member ID'],
  ['Mobile_Number', 'मोबाईल नंबर'],
  ['Address', 'पत्ता'],
  ['District', 'जिल्हा'],
  ['Taluka', 'तालुका'],
  ['Village', 'गाव'],
  ['Occupation', 'व्यवसाय'],
  ['Loan_Purpose', 'कर्जाचा उद्देश'],
  ['Required_Loan_Amount', 'आवश्यक रक्कम']
];

async function searchApplication() {
  const mobile = $('mobile').value.replace(/\D/g, '');
  const applicationId = $('applicationId').value.trim();

  if (!/^\d{10}$/.test(mobile)) {
    showMessage('योग्य 10 अंकी मोबाईल नंबर भरा.', 'error');
    return;
  }
  if (!applicationId) {
    showMessage('Application ID भरा.', 'error');
    return;
  }

  setBusy('searchBtn', true, 'अर्ज शोधत आहे...');
  try {
    const result = await getJSONP({
      action: 'search', mobile, applicationId
    });

    if (!result.success) throw new Error(result.message || 'अर्ज सापडला नाही.');

    verificationId = safeText(result.verificationId);
    verificationNumber = safeText(result.verificationNumber);

    if (!verificationId || !verificationNumber) {
      throw new Error('Verification ID मिळाला नाही.');
    }

    const member = result.member || {};
    const container = $('memberDetails');
    container.replaceChildren();

    displayFields.forEach(([key, title]) => {
      if (member[key] === undefined || member[key] === '') return;
      const box = document.createElement('div');
      const label = document.createElement('strong');
      const value = document.createElement('span');
      label.textContent = title;
      value.textContent = safeText(member[key]);
      box.append(label, value);
      container.appendChild(box);
    });

    $('verificationNumber').textContent = verificationNumber;
    showSection('memberCard');
    showMessage('अर्ज सापडला. माहिती तपासा आणि पुढे जा.', 'ok');

    await loadAgreement();
  } catch (e) {
    showMessage(e.message || 'अर्ज शोधताना त्रुटी आली.', 'error');
  } finally {
    setBusy('searchBtn', false);
  }
}

async function loadAgreement() {
  try {
    const result = await getJSONP({action:'agreement'});
    if (!result.success) throw new Error(result.message || 'करारपत्र उपलब्ध नाही.');

    agreementVersion = safeText(result.version);
    $('agreementTitle').textContent = safeText(result.title || 'करारपत्र');
    $('agreementContent').textContent = safeText(result.content);
  } catch (e) {
    $('agreementContent').textContent =
      'करारपत्र लोड झाले नाही. कृपया पुन्हा प्रयत्न करा.';
    showMessage(e.message || 'करारपत्र लोड झाले नाही.', 'error');
  }
}

$('selfie').addEventListener('change', () => {
  const file = $('selfie').files[0];
  selfieSaved = false;
  if (!file) return;

  if (!file.type.startsWith('image/')) {
    showMessage('कृपया image फाईल निवडा.', 'error');
    $('selfie').value = '';
    return;
  }
  if (file.size > 4 * 1024 * 1024) {
    showMessage('फोटो 4 MB पेक्षा लहान निवडा.', 'error');
    $('selfie').value = '';
    return;
  }

  $('selfiePreview').src = URL.createObjectURL(file);
  $('selfiePreview').classList.remove('hidden');
});

function fileToDataURL(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = () => reject(new Error('फोटो वाचता आला नाही.'));
    reader.readAsDataURL(file);
  });
}

async function uploadSelfie() {
  if (!verificationId) {
    showMessage('प्रथम अर्ज शोधा.', 'error');
    return;
  }
  const file = $('selfie').files[0];
  if (!file) {
    showMessage('प्रथम सेल्फी फोटो घ्या.', 'error');
    return;
  }

  setBusy('selfieBtn', true, 'फोटो सेव्ह होत आहे...');
  try {
    const imageData = await fileToDataURL(file);
    const result = await postAPI({
      action:'saveSelfie', verificationId, imageData
    });
    if (!result.success) throw new Error(result.message || 'फोटो सेव्ह झाला नाही.');

    selfieSaved = true;
    showSection('agreementCard');
    showMessage('सेल्फी सेव्ह झाला.', 'ok');
    $('agreementCard').scrollIntoView({behavior:'smooth'});
  } catch (e) {
    showMessage('सेल्फी सेव्ह करताना त्रुटी: ' + e.message, 'error');
  } finally {
    setBusy('selfieBtn', false);
  }
}

async function acceptAgreement() {
  if (!verificationId) return showMessage('प्रथम अर्ज शोधा.', 'error');
  if (!selfieSaved) return showMessage('प्रथम सेल्फी सेव्ह करा.', 'error');
  if (!$('agree').checked) {
    return showMessage('करारपत्र स्वीकारण्यासाठी चेकबॉक्स निवडा.', 'error');
  }

  setBusy('agreeBtn', true, 'संमती सेव्ह होत आहे...');
  try {
    const result = await postAPI({
      action:'acceptAgreement',
      verificationId,
      accepted:true,
      agreementVersion
    });
    if (!result.success) throw new Error(result.message || 'संमती सेव्ह झाली नाही.');

    agreementSaved = true;
    showSection('bankCard');
    showMessage('करारपत्राची संमती नोंदवली.', 'ok');
    $('bankCard').scrollIntoView({behavior:'smooth'});
  } catch (e) {
    showMessage('संमती सेव्ह करताना त्रुटी: ' + e.message, 'error');
  } finally {
    setBusy('agreeBtn', false);
  }
}

async function saveBank() {
  if (!agreementSaved) return showMessage('प्रथम करारपत्र स्वीकारा.', 'error');

  const accountHolderName = $('holder').value.trim();
  const bankName = $('bank').value.trim();
  const accountNumber = $('account').value.trim();
  const ifscCode = $('ifsc').value.trim().toUpperCase();
  const branchName = $('branch').value.trim();

  if (!accountHolderName || !bankName || !accountNumber) {
    return showMessage('खातेदाराचे नाव, बँक आणि खाते क्रमांक भरा.', 'error');
  }
  if (!/^[A-Z]{4}0[A-Z0-9]{6}$/.test(ifscCode)) {
    return showMessage('IFSC कोड योग्य भरा.', 'error');
  }

  setBusy('bankBtn', true, 'बँक तपशील सेव्ह होत आहेत...');
  try {
    const result = await postAPI({
      action:'saveBank', verificationId,
      accountHolderName, bankName, accountNumber, ifscCode, branchName
    });
    if (!result.success) throw new Error(result.message || 'बँक तपशील सेव्ह झाले नाहीत.');

    bankSaved = true;
    showSection('signatureCard');
    showMessage('बँक तपशील सेव्ह झाले.', 'ok');
    $('signatureCard').scrollIntoView({behavior:'smooth'});
  } catch (e) {
    showMessage('बँक तपशील सेव्ह करताना त्रुटी: ' + e.message, 'error');
  } finally {
    setBusy('bankBtn', false);
  }
}

/* मोबाईलवर बोटाने सही करण्यासाठी Canvas */
const canvas = $('signatureCanvas');
const ctx = canvas.getContext('2d');
let drawing = false;
let hasSignature = false;

function resizeCanvas() {
  const rect = canvas.getBoundingClientRect();
  const ratio = Math.max(window.devicePixelRatio || 1, 1);
  const old = hasSignature ? canvas.toDataURL() : null;
  canvas.width = rect.width * ratio;
  canvas.height = rect.height * ratio;
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
  ctx.lineWidth = 2.5;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.strokeStyle = '#102d50';
  if (old) {
    const img = new Image();
    img.onload = () => ctx.drawImage(img, 0, 0, rect.width, rect.height);
    img.src = old;
  }
}
function pointerPosition(e) {
  const r = canvas.getBoundingClientRect();
  return {x:e.clientX-r.left, y:e.clientY-r.top};
}
canvas.addEventListener('pointerdown', e => {
  drawing = true;
  hasSignature = true;
  canvas.setPointerCapture(e.pointerId);
  const p = pointerPosition(e);
  ctx.beginPath();
  ctx.moveTo(p.x,p.y);
});
canvas.addEventListener('pointermove', e => {
  if (!drawing) return;
  const p = pointerPosition(e);
  ctx.lineTo(p.x,p.y);
  ctx.stroke();
});
function stopDrawing() { drawing = false; }
canvas.addEventListener('pointerup', stopDrawing);
canvas.addEventListener('pointercancel', stopDrawing);
canvas.addEventListener('pointerleave', stopDrawing);

window.addEventListener('resize', resizeCanvas);
resizeCanvas();

function clearSignature() {
  ctx.clearRect(0,0,canvas.width,canvas.height);
  hasSignature = false;
}

async function saveSignature() {
  if (!bankSaved) return showMessage('प्रथम बँक तपशील सेव्ह करा.', 'error');
  if (!hasSignature) return showMessage('प्रथम सही करा.', 'error');

  setBusy('signatureBtn', true, 'सही सेव्ह होत आहे...');
  try {
    const imageData = canvas.toDataURL('image/png');
    const result = await postAPI({
      action:'saveSignature', verificationId, imageData
    });
    if (!result.success) throw new Error(result.message || 'सही सेव्ह झाली नाही.');

    signatureSaved = true;
    $('finalNumber').textContent = verificationNumber;
    showSection('finishCard');
    showMessage('सही सेव्ह झाली. Verification Number जतन करा.', 'ok');
    $('finishCard').scrollIntoView({behavior:'smooth'});
  } catch (e) {
    showMessage('सही सेव्ह करताना त्रुटी: ' + e.message, 'error');
  } finally {
    setBusy('signatureBtn', false);
  }
}

async function copyNumber() {
  try {
    await navigator.clipboard.writeText(verificationNumber);
    showMessage('Verification Number कॉपी झाला.', 'ok');
  } catch (e) {
    showMessage('तुमचा Verification Number: ' + verificationNumber, 'ok');
  }
}
</script>
</body>
</html>
